#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
LAUNCHER="$SCRIPT_DIR/../tools/agents/start_herdr.sh"

POSITIONAL=()
FLAGS=()
for arg in "$@"; do
  case "$arg" in
    --*) FLAGS+=("$arg") ;;
    *) POSITIONAL+=("$arg") ;;
  esac
done

if [ "${#POSITIONAL[@]}" -gt 2 ]; then
  echo "Usage: start-herdr [claude|codex|opencode|cursor] [WORKSPACE_PATH] [--local-model|--gpu-box]" >&2
  echo "   or: start-herdr [WORKSPACE_PATH] [claude|codex|opencode|cursor] [--local-model|--gpu-box]" >&2
  exit 1
fi

case "${POSITIONAL[0]:-}" in
  claude|codex|opencode|cursor)
    exec "$LAUNCHER" "${POSITIONAL[1]:-$PWD}" "${POSITIONAL[0]}" ${FLAGS[@]+"${FLAGS[@]}"}
    ;;
  "")
    exec "$LAUNCHER" "$PWD" cursor ${FLAGS[@]+"${FLAGS[@]}"}
    ;;
  *)
    exec "$LAUNCHER" "${POSITIONAL[@]}" ${FLAGS[@]+"${FLAGS[@]}"}
    ;;
esac
