#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd -P)"
AWS_DIR="$SCRIPT_DIR/../infra/aws"
WORKBENCH_TAG="aws-native-agent-workbench-ec2"
GPU_TAG="aws-native-agent-workbench-gpu-llm"
GPU_CACHE_STACK="AwsNativeWorkbenchLlmCacheStack"
GPU_STACK="AwsNativeWorkbenchLlmStack"
GPU_INSTANCE_TYPE="${WORKBENCH_LLM_INSTANCE_TYPE:-g6e.xlarge}"
GPU_CONTEXT_LENGTH="${WORKBENCH_LLM_CONTEXT_LENGTH:-131072}"
GPU_KV_CACHE_TYPE="${WORKBENCH_LLM_KV_CACHE_TYPE:-q8_0}"

usage() {
  cat <<'EOF'
Usage: workbench <ec2|llm> <command>

ec2: up, down, status, ssm, ssh, update
llm: up, down, status

SSM is the default connection. SSH requires sshCidr and a key at deploy time.

Set WORKBENCH_EC2_SSH_KEY when the private key is not loaded in ssh-agent or
stored at a default OpenSSH path.
EOF
  exit 1
}

instance_ids_by_tag() {
  aws ec2 describe-instances \
    --filters \
      "Name=tag:Name,Values=$1" \
      "Name=instance-state-name,Values=pending,running,stopping,stopped" \
    --query 'Reservations[].Instances[].InstanceId' \
    --output text
}

workbench_instance_id() {
  local instance_id
  instance_id="$(instance_ids_by_tag "$WORKBENCH_TAG")"
  if [ -z "$instance_id" ] || [ "$instance_id" = None ]; then
    echo "ERROR: No AWS workbench instance is deployed." >&2
    exit 1
  fi
  echo "$instance_id"
}

gpu_instance_ids() {
  instance_ids_by_tag "$GPU_TAG"
}

instance_state() {
  aws ec2 describe-instances --instance-ids "$1" \
    --query 'Reservations[0].Instances[0].State.Name' --output text
}

instance_public_ip() {
  aws ec2 describe-instances --instance-ids "$1" \
    --query 'Reservations[0].Instances[0].PublicIpAddress' --output text
}

gpu_stack_exists() {
  aws cloudformation describe-stacks --stack-name "$GPU_STACK" >/dev/null 2>&1
}

require_aws_project() {
  if [ ! -f "$AWS_DIR/cdk.json" ]; then
    echo "ERROR: AWS CDK project not found at $AWS_DIR." >&2
    exit 1
  fi
}

spot_capacity_is_poor() {
  local region score
  region="${AWS_REGION:-$(aws configure get region 2>/dev/null)}"
  [ -n "$region" ] || return 1
  score="$(aws ec2 get-spot-placement-scores \
    --instance-types "$GPU_INSTANCE_TYPE" \
    --target-capacity 1 \
    --target-capacity-unit-type units \
    --region-names "$region" \
    --query 'SpotPlacementScores[0].Score' \
    --output text 2>/dev/null)" || return 1
  case "$score" in
    "" | *[!0-9]*) return 1 ;;
  esac
  [ "$score" -lt 7 ]
}

deploy_gpu() {
  local purchase_option="$1"
  (cd "$AWS_DIR" && npx cdk deploy "$GPU_CACHE_STACK" "$GPU_STACK" \
    --require-approval never \
    -c llmInstanceType="$GPU_INSTANCE_TYPE" \
    -c llmContextLength="$GPU_CONTEXT_LENGTH" \
    -c llmKvCacheType="$GPU_KV_CACHE_TYPE" \
    -c llmPurchaseOption="$purchase_option")
}

deploy_gpu_with_fallback() {
  local deploy_log
  if spot_capacity_is_poor; then
    echo "Spot capacity looks poor. Using On-Demand." >&2
    deploy_gpu on-demand
    return
  fi

  deploy_log="$(mktemp)"
  if deploy_gpu spot 2>&1 | tee "$deploy_log"; then
    rm -f "$deploy_log"
    return
  fi
  if ! grep -q "Unable to fulfill capacity" "$deploy_log"; then
    rm -f "$deploy_log"
    return 1
  fi
  rm -f "$deploy_log"
  echo "Spot capacity is unavailable. Using On-Demand." >&2
  if gpu_stack_exists; then
    (cd "$AWS_DIR" && npx cdk destroy "$GPU_STACK" --force)
  fi
  deploy_gpu on-demand
}

wait_for_gpu() {
  local instance_id command_id status attempts=0
  instance_id="$(gpu_instance_ids)"
  instance_id="${instance_id%%[[:space:]]*}"
  while [ -z "$instance_id" ] || [ "$instance_id" = None ]; do
    attempts=$((attempts + 1))
    if [ "$attempts" -ge 30 ]; then
      echo "ERROR: No GPU instance appeared." >&2
      return 1
    fi
    sleep 10
    instance_id="$(gpu_instance_ids)"
    instance_id="${instance_id%%[[:space:]]*}"
  done

  attempts=0
  while :; do
    command_id="$(aws ssm send-command \
      --instance-ids "$instance_id" \
      --document-name AWS-RunShellScript \
      --parameters 'commands=["curl -fsS --max-time 60 http://127.0.0.1:11435/v1/models | grep -Fq qwen3.8:27b"]' \
      --query 'Command.CommandId' --output text 2>/dev/null || true)"
    if [ -n "$command_id" ]; then
      aws ssm wait command-executed \
        --command-id "$command_id" --instance-id "$instance_id" 2>/dev/null || true
      status="$(aws ssm get-command-invocation \
        --command-id "$command_id" --instance-id "$instance_id" \
        --query Status --output text 2>/dev/null || true)"
      [ "$status" = Success ] && return
    fi
    attempts=$((attempts + 1))
    echo "Waiting for the GPU model."
    if [ "$attempts" -ge 30 ]; then
      echo "ERROR: The GPU model did not become ready." >&2
      return 1
    fi
    sleep 10
  done
}

case "${1:-}" in
  ec2)
    case "${2:-}" in
      up)
        instance_id="$(workbench_instance_id)"
        state="$(instance_state "$instance_id")"
        if [ "$state" = stopping ]; then
          aws ec2 wait instance-stopped --instance-ids "$instance_id"
          state=stopped
        fi
        if [ "$state" = stopped ]; then
          aws ec2 start-instances --instance-ids "$instance_id" >/dev/null
        fi
        aws ec2 wait instance-running --instance-ids "$instance_id"
        aws ec2 wait instance-status-ok --instance-ids "$instance_id"
        echo "Running. Connect with: workbench ec2 ssm"
        ;;
      down)
        instance_id="$(workbench_instance_id)"
        aws ec2 stop-instances --instance-ids "$instance_id" >/dev/null
        echo "Stopping $instance_id."
        ;;
      status)
        instance_id="$(workbench_instance_id)"
        aws ec2 describe-instances --instance-ids "$instance_id" \
          --query 'Reservations[0].Instances[0].{State:State.Name,Type:InstanceType,StartedAt:LaunchTime,PublicIp:PublicIpAddress}' \
          --output table
        ;;
      ssm)
        instance_id="$(workbench_instance_id)"
        exec aws ssm start-session \
          --target "$instance_id" \
          --document-name AWS-StartInteractiveCommand \
          --parameters 'command=["sudo -iu ubuntu"]'
        ;;
      ssh)
        instance_id="$(workbench_instance_id)"
        public_ip="$(instance_public_ip "$instance_id")"
        if [ -z "$public_ip" ] || [ "$public_ip" = None ]; then
          echo "ERROR: The workbench has no public IP." >&2
          exit 1
        fi
        ssh_arguments=()
        if [ -n "${WORKBENCH_EC2_SSH_KEY:-}" ]; then
          ssh_arguments=(-i "$WORKBENCH_EC2_SSH_KEY")
        fi
        exec ssh "${ssh_arguments[@]}" "${WORKBENCH_EC2_USER:-ubuntu}@$public_ip"
        ;;
      update)
        instance_id="$(workbench_instance_id)"
        branch="${3:-$(git -C "$SCRIPT_DIR/.." branch --show-current)}"
        if [[ ! "$branch" =~ ^[A-Za-z0-9._/-]+$ ]]; then
          echo "ERROR: Unsupported branch name: $branch" >&2
          exit 1
        fi
        exec aws ssm start-session \
          --target "$instance_id" \
          --document-name AWS-StartInteractiveCommand \
          --parameters "command=[\"sudo git -C /opt/agent-workbench fetch --prune origin $branch && sudo git -C /opt/agent-workbench reset --hard origin/$branch && sudo bash /opt/agent-workbench/infra/aws/ec2/setup-workbench.sh\"]"
        ;;
      *) usage ;;
    esac
    ;;
  llm)
    case "${2:-}" in
      up)
        require_aws_project
        instance_ids="$(gpu_instance_ids)"
        if gpu_stack_exists && { [ -z "$instance_ids" ] || [ "$instance_ids" = None ]; }; then
          (cd "$AWS_DIR" && npx cdk destroy "$GPU_STACK" --force)
        fi
        deploy_gpu_with_fallback
        wait_for_gpu
        echo "GPU model ready on the workbench VPC."
        ;;
      down)
        require_aws_project
        (cd "$AWS_DIR" && npx cdk destroy "$GPU_STACK" --force)
        echo "GPU instance removed. The model cache remains."
        ;;
      status)
        instance_ids="$(gpu_instance_ids)"
        if [ -z "$instance_ids" ] || [ "$instance_ids" = None ]; then
          echo "off"
          exit
        fi
        aws ec2 describe-instances --instance-ids $instance_ids \
          --query 'Reservations[].Instances[].{Id:InstanceId,State:State.Name,Type:InstanceType,StartedAt:LaunchTime,PrivateIp:PrivateIpAddress}' \
          --output table
        ;;
      *) usage ;;
    esac
    ;;
  *) usage ;;
esac
