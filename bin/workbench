#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd -P)"
AWS_DIR="$SCRIPT_DIR/../infra/aws"

INSTANCE_NAME_TAG="agent-workbench-ec2"
LLM_INSTANCE_NAME_TAG="agent-workbench-gpu-llm"
LLM_CACHE_STACK="AgentWorkbenchLlmCacheStack"
LLM_STACK="AgentWorkbenchLlmStack"
# Must match INSTANCE_TYPE and LLM_MODEL in infra/aws/lib/workbench-llm-stack.ts.
LLM_INSTANCE_TYPE="g6.xlarge"
LLM_MODEL="qwen3.8:27b"
# AWS forecasts Spot capacity from 1 to 10. Below this, skip the Spot attempt
# and its failed deploy and rollback.
LLM_SPOT_SCORE_MIN=7
CONNECT_USER="${WORKBENCH_EC2_USER:-ubuntu}"

tailscale_ip() {
  tailscale status --json 2>/dev/null |
    jq -r --arg name "$1" \
      '[.Peer[]? | select(.Online and (.HostName == $name or (.HostName | test("^\($name)-[0-9]+$"))))][0].TailscaleIPs[0] // empty' \
      2>/dev/null || true
}

# After a rebuild, a dead tailnet node can still hold the agent-workbench
# MagicDNS name and the new node gets agent-workbench-1. Find the online node
# by its hostname instead, so connections survive instance replacement.
find_connect_host() {
  if [ -n "${WORKBENCH_EC2_HOST:-}" ]; then
    echo "$WORKBENCH_EC2_HOST"
    return
  fi
  local ip
  ip="$(tailscale_ip agent-workbench)"
  echo "${ip:-agent-workbench}"
}

usage() {
  cat <<'EOF'
Usage: workbench <target> <command>

Targets:
  ec2   Persistent workbench instance
  llm   GPU instance for the local LLM

ec2 commands:
  up         Start the instance and wait until it runs
  down       Stop the instance now
  status     Show instance state, type, and uptime
  ssh        Connect with ssh over Tailscale
  mosh       Connect with mosh over Tailscale
  ssm        Connect with SSM (break-glass, no Tailscale needed)
  update     Re-run the setup script on the box and refresh skills
  sync-host  Point agent-workbench in /etc/hosts at the box's Tailscale IP
  trust-host Read the SSH host key over SSM and refresh known_hosts

llm commands:
  up         Try Spot, then deploy On-Demand if Spot is unavailable
  down       Destroy the GPU instance. The cache bucket stays.
  status     Show whether the GPU instance is running
  trust-host Read the SSH host key over SSM and refresh known_hosts

Environment:
  WORKBENCH_EC2_HOST  Tailscale host override (default: found with tailscale status)
  WORKBENCH_EC2_USER  Login user (default: ubuntu)
EOF
  exit 1
}

# For browsers whose DNS-over-HTTPS resolver bypasses MagicDNS: keep the
# agent-workbench line in /etc/hosts pointed at the box's Tailscale IP.
# Waits for the box, since a rebuilt instance takes minutes to join the tailnet.
sync_host() {
  local ip tries=0
  while :; do
    ip="$(tailscale_ip agent-workbench)"
    [ -n "$ip" ] && break
    tries=$((tries + 1))
    if [ "$tries" -eq 1 ]; then echo "Waiting for the workbench to come online on the tailnet..."; fi
    if [ "$tries" -gt 60 ]; then echo "ERROR: workbench not online after 10 minutes." >&2; return 1; fi
    sleep 10
  done
  sudo sed -i.bak '/ agent-workbench$/d' /etc/hosts
  echo "$ip agent-workbench" | sudo tee -a /etc/hosts >/dev/null
  sudo rm -f /etc/hosts.bak
  echo "agent-workbench -> $ip"
}

find_instance_id() {
  local instance_id
  instance_id="$(aws ec2 describe-instances \
    --filters \
      "Name=tag:Name,Values=$INSTANCE_NAME_TAG" \
      "Name=instance-state-name,Values=pending,running,stopping,stopped" \
    --query 'Reservations[].Instances[].InstanceId' \
    --output text)"

  if [ -z "$instance_id" ] || [ "$instance_id" = "None" ]; then
    echo "ERROR: No instance found with tag Name=$INSTANCE_NAME_TAG. Deploy the stack first." >&2
    exit 1
  fi

  echo "$instance_id"
}

instance_state() {
  aws ec2 describe-instances --instance-ids "$1" \
    --query 'Reservations[0].Instances[0].State.Name' --output text
}

# A replaced instance has new SSH host keys, so ssh refuses to connect and mosh
# fails with it. Read the real key over SSM, which AWS authenticates and which
# does not use ssh, then replace the stale known_hosts entries. Reading it over
# ssh would prove nothing: that is the channel in doubt.
trust_host() {
  local instance_id="$1" name="$2"
  local command_id status key ip key_file

  echo "Reading the host key from $instance_id over SSM..."
  command_id="$(aws ssm send-command \
    --instance-ids "$instance_id" \
    --document-name AWS-RunShellScript \
    --parameters 'commands=["cat /etc/ssh/ssh_host_ed25519_key.pub"]' \
    --query 'Command.CommandId' --output text)"

  aws ssm wait command-executed \
    --command-id "$command_id" --instance-id "$instance_id" 2>/dev/null || true
  status="$(aws ssm get-command-invocation \
    --command-id "$command_id" --instance-id "$instance_id" \
    --query 'Status' --output text)"
  if [ "$status" != "Success" ]; then
    echo "ERROR: The SSM command ended as $status. Is the box running with the SSM agent?" >&2
    return 1
  fi

  key="$(aws ssm get-command-invocation \
    --command-id "$command_id" --instance-id "$instance_id" \
    --query 'StandardOutputContent' --output text |
    awk '/^ssh-ed25519 / { print $1, $2; exit }')"
  if [ -z "$key" ]; then
    echo "ERROR: The box returned no ed25519 host key." >&2
    return 1
  fi

  key_file="$(mktemp)"
  printf '%s\n' "$key" > "$key_file"
  echo "Host key: $(ssh-keygen -lf "$key_file" | awk '{print $2}')"
  rm -f "$key_file"

  mkdir -p "$HOME/.ssh"
  chmod 700 "$HOME/.ssh"
  touch "$HOME/.ssh/known_hosts"

  # ssh connects by MagicDNS name or by Tailscale IP, depending on which node
  # holds the name, so trust both.
  ip="$(tailscale_ip "$name")"
  for host in "$name" ${ip:+$ip}; do
    ssh-keygen -R "$host" -f "$HOME/.ssh/known_hosts" >/dev/null 2>&1 || true
    printf '%s %s\n' "$host" "$key" >> "$HOME/.ssh/known_hosts"
    echo "Trusted $host"
  done
  rm -f "$HOME/.ssh/known_hosts.old"
}

require_aws_dir() {
  if [ ! -f "$AWS_DIR/cdk.json" ]; then
    echo "ERROR: CDK app not found at $AWS_DIR" >&2
    exit 1
  fi
}

llm_stack_exists() {
  aws cloudformation describe-stacks --stack-name "$LLM_STACK" \
    >/dev/null 2>&1
}

llm_instance_ids() {
  aws ec2 describe-instances \
    --filters \
      "Name=tag:Name,Values=$LLM_INSTANCE_NAME_TAG" \
      "Name=instance-state-name,Values=pending,running,shutting-down,stopping,stopped" \
    --query 'Reservations[].Instances[].InstanceId' \
    --output text
}

# The fleet spans every public subnet, so it needs capacity in any one AZ.
# That is what the region score answers.
spot_score_is_poor() {
  local region score
  region="${AWS_REGION:-$(aws configure get region 2>/dev/null)}"
  [ -n "$region" ] || return 1

  score="$(aws ec2 get-spot-placement-scores \
    --instance-types "$LLM_INSTANCE_TYPE" \
    --target-capacity 1 \
    --target-capacity-unit-type units \
    --region-names "$region" \
    --query 'SpotPlacementScores[0].Score' \
    --output text 2>/dev/null)" || return 1

  # No score means no forecast, so try Spot rather than overpay on a guess.
  case "$score" in
    "" | *[!0-9]*) return 1 ;;
  esac

  [ "$score" -lt "$LLM_SPOT_SCORE_MIN" ] &&
    echo "Spot capacity score for $LLM_INSTANCE_TYPE in $region is $score." >&2
}

# Ollama serves one request at a time, so a completion returns only once the
# boot warmup has finished and the model sits in VRAM.
wait_llm_ready() {
  local ip minutes=0
  while :; do
    ip="$(tailscale_ip agent-llm)"
    [ -n "$ip" ] && break
    minutes=$((minutes + 1))
    if [ "$minutes" -eq 1 ]; then echo "Waiting for the GPU box to join the tailnet..."; fi
    if [ "$minutes" -gt 5 ]; then
      echo "WARN: The box is not on the tailnet after 5 minutes." >&2
      echo "Look at the boot log: workbench llm trust-host, then" >&2
      echo "  ssh $CONNECT_USER@agent-llm 'sudo cat /var/log/cloud-init-output.log'" >&2
      return 1
    fi
    sleep 60
  done

  minutes=0
  while :; do
    if curl -fsS --max-time 60 "http://$ip:11435/v1/chat/completions" \
      -H 'Content-Type: application/json' \
      -d "{\"model\":\"$LLM_MODEL\",\"messages\":[{\"role\":\"user\",\"content\":\"hi\"}],\"max_tokens\":1}" \
      >/dev/null 2>&1; then
      return 0
    fi
    minutes=$((minutes + 1))
    echo "Loading the model. $minutes min so far."
    if [ "$minutes" -gt 10 ]; then
      echo "WARN: No answer after 10 minutes. A first-ever boot pulls 17 GB and" >&2
      echo "takes about 30, so give it longer only if the log says Cache miss:" >&2
      echo "  ssh $CONNECT_USER@agent-llm 'sudo tail /var/log/cloud-init-output.log'" >&2
      return 1
    fi
  done
}

deploy_llm_with_spot() {
  local deploy_log
  deploy_log="$(mktemp)"

  if (cd "$AWS_DIR" && npx cdk deploy "$LLM_CACHE_STACK" "$LLM_STACK" \
    --require-approval never \
    -c llmPurchaseOption=spot 2>&1 | tee "$deploy_log"); then
    rm -f "$deploy_log"
    return 0
  fi

  if grep -q "Unable to fulfill capacity" "$deploy_log"; then
    rm -f "$deploy_log"
    return 2
  fi

  rm -f "$deploy_log"
  return 1
}

deploy_llm_on_demand() {
  cat >&2 <<'EOF'

========================================================================
WARNING: SPOT GPU CAPACITY IS UNAVAILABLE
Falling back to an On-Demand g6.xlarge instance.
This instance costs more than Spot.
The 1-hour idle shutdown and 12-hour safety limit remain active.
========================================================================

EOF
  if llm_stack_exists; then
    (cd "$AWS_DIR" && npx cdk destroy "$LLM_STACK" --force)
  fi
  (cd "$AWS_DIR" && npx cdk deploy "$LLM_CACHE_STACK" "$LLM_STACK" \
    --require-approval never \
    -c llmPurchaseOption=on-demand)
}

case "${1:-}" in
  ec2)
    case "${2:-}" in
      up)
        instance_id="$(find_instance_id)"
        state="$(instance_state "$instance_id")"

        # The idle timer stops the box on its own. EC2 refuses a start while the
        # instance is still stopping, so wait for the stop to finish first.
        if [ "$state" = "stopping" ]; then
          echo "$instance_id is stopping. Waiting for it to stop..."
          aws ec2 wait instance-stopped --instance-ids "$instance_id"
          state=stopped
        fi

        if [ "$state" = "stopped" ]; then
          aws ec2 start-instances --instance-ids "$instance_id" >/dev/null
          echo "Starting $instance_id..."
        else
          echo "$instance_id is $state."
        fi

        aws ec2 wait instance-running --instance-ids "$instance_id"
        echo "Running. Connect with: workbench ec2 mosh"
        echo "A new instance joins the tailnet by itself on first boot. Give it a few minutes."
        ;;
      down)
        instance_id="$(find_instance_id)"
        aws ec2 stop-instances --instance-ids "$instance_id" >/dev/null
        echo "Stopping $instance_id."
        ;;
      status)
        instance_id="$(find_instance_id)"
        aws ec2 describe-instances --instance-ids "$instance_id" \
          --query 'Reservations[0].Instances[0].{State:State.Name,Type:InstanceType,StartedAt:LaunchTime,PublicIp:PublicIpAddress}' \
          --output table
        ;;
      ssh)
        # Ghostty's own TERM is unknown on the box and its keyboard protocol
        # garbles mosh, so connect with the plain terminal type.
        exec env TERM=xterm-256color ssh "$CONNECT_USER@$(find_connect_host)"
        ;;
      mosh)
        exec env TERM=xterm-256color mosh "$CONNECT_USER@$(find_connect_host)"
        ;;
      ssm)
        exec aws ssm start-session --target "$(find_instance_id)"
        ;;
      update)
        # /opt/agent-workbench is root-owned machine config, not a working copy.
        # Hard reset to origin/main so the box cannot run a stale or local branch.
        exec ssh "$CONNECT_USER@$(find_connect_host)" \
          'sudo git -C /opt/agent-workbench fetch --prune origin main \
            && sudo git -C /opt/agent-workbench reset --hard origin/main \
            && sudo bash /opt/agent-workbench/infra/aws/ec2/setup-workbench.sh'
        ;;
      sync-host)
        sync_host
        ;;
      trust-host)
        trust_host "$(find_instance_id)" agent-workbench
        ;;
      *)
        usage
        ;;
    esac
    ;;
  llm)
    case "${2:-}" in
      up)
        require_aws_dir
        # The box terminates itself when idle. CloudFormation still holds the
        # dead instance, and a deploy will not replace it.
        instance_ids="$(llm_instance_ids)"
        if llm_stack_exists && { [ -z "$instance_ids" ] || [ "$instance_ids" = "None" ]; }; then
          echo "The last GPU box is gone. Clearing the old stack first."
          (cd "$AWS_DIR" && npx cdk destroy "$LLM_STACK" --force)
        fi
        if spot_score_is_poor; then
          deploy_llm_on_demand
        elif deploy_llm_with_spot; then
          :
        else
          deploy_status=$?
          if [ "$deploy_status" -ne 2 ]; then
            exit "$deploy_status"
          fi
          deploy_llm_on_demand
        fi
        if wait_llm_ready; then
          echo "Model ready. Start an agent with --gpu-box."
        else
          echo "Check with: workbench llm status"
        fi
        echo "Before ssh to the box: workbench llm trust-host"
        ;;
      down)
        require_aws_dir
        (cd "$AWS_DIR" && npx cdk destroy "$LLM_STACK" --force)
        echo "GPU instance removed. The model cache remains."
        ;;
      status)
        instance_ids="$(llm_instance_ids)"
        if [ -z "$instance_ids" ] || [ "$instance_ids" = "None" ]; then
          echo "off"
          exit 0
        fi
        aws ec2 describe-instances --instance-ids $instance_ids \
          --query 'Reservations[].Instances[].{Id:InstanceId,State:State.Name,Type:InstanceType,StartedAt:LaunchTime,PublicIp:PublicIpAddress}' \
          --output table
        ;;
      trust-host)
        instance_ids="$(llm_instance_ids)"
        if [ -z "$instance_ids" ] || [ "$instance_ids" = "None" ]; then
          echo "ERROR: No GPU box is running. Deploy it first." >&2
          exit 1
        fi
        trust_host "${instance_ids%%[[:space:]]*}" agent-llm
        ;;
      *)
        usage
        ;;
    esac
    ;;
  *)
    usage
    ;;
esac
