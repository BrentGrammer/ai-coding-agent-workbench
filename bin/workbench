#!/usr/bin/env bash
set -euo pipefail

INSTANCE_NAME_TAG="agent-workbench-ec2"
CONNECT_USER="${WORKBENCH_EC2_USER:-ubuntu}"

# After a rebuild, a dead tailnet node can still hold the agent-workbench
# MagicDNS name and the new node gets agent-workbench-1. Find the online node
# by its hostname instead, so connections survive instance replacement.
find_connect_host() {
  if [ -n "${WORKBENCH_EC2_HOST:-}" ]; then
    echo "$WORKBENCH_EC2_HOST"
    return
  fi
  local ip
  ip="$(tailscale status --json 2>/dev/null |
    jq -r '[.Peer[]? | select(.HostName == "agent-workbench" and .Online)][0].TailscaleIPs[0] // empty' \
      2>/dev/null || true)"
  echo "${ip:-agent-workbench}"
}

usage() {
  cat <<'EOF'
Usage: workbench ec2 <command>

Commands:
  up      Start the instance and wait until it runs
  down    Stop the instance now
  status  Show instance state, type, and uptime
  ssh     Connect with ssh over Tailscale
  mosh    Connect with mosh over Tailscale
  ssm        Connect with SSM (break-glass, no Tailscale needed)
  update     Re-run the setup script on the box and refresh skills
  sync-host  Point agent-workbench in /etc/hosts at the box's Tailscale IP

Environment:
  WORKBENCH_EC2_HOST  Tailscale host override (default: found with tailscale status)
  WORKBENCH_EC2_USER  Login user (default: ubuntu)
EOF
  exit 1
}

# For browsers whose DNS-over-HTTPS resolver bypasses MagicDNS: keep the
# agent-workbench line in /etc/hosts pointed at the box's Tailscale IP.
# Waits for the box, since a rebuilt instance takes minutes to join the tailnet.
sync_host() {
  local ip tries=0
  while :; do
    ip="$(tailscale status --json 2>/dev/null |
      jq -r '[.Peer[]? | select(.HostName == "agent-workbench" and .Online)][0].TailscaleIPs[0] // empty')"
    [ -n "$ip" ] && break
    tries=$((tries + 1))
    if [ "$tries" -eq 1 ]; then echo "Waiting for the workbench to come online on the tailnet..."; fi
    if [ "$tries" -gt 60 ]; then echo "ERROR: workbench not online after 10 minutes." >&2; return 1; fi
    sleep 10
  done
  sudo sed -i.bak '/ agent-workbench$/d' /etc/hosts
  echo "$ip agent-workbench" | sudo tee -a /etc/hosts >/dev/null
  sudo rm -f /etc/hosts.bak
  echo "agent-workbench -> $ip"
}

find_instance_id() {
  local instance_id
  instance_id="$(aws ec2 describe-instances \
    --filters \
      "Name=tag:Name,Values=$INSTANCE_NAME_TAG" \
      "Name=instance-state-name,Values=pending,running,stopping,stopped" \
    --query 'Reservations[].Instances[].InstanceId' \
    --output text)"

  if [ -z "$instance_id" ] || [ "$instance_id" = "None" ]; then
    echo "ERROR: No instance found with tag Name=$INSTANCE_NAME_TAG. Deploy the stack first." >&2
    exit 1
  fi

  echo "$instance_id"
}

[ "${1:-}" = "ec2" ] || usage

case "${2:-}" in
  up)
    instance_id="$(find_instance_id)"
    aws ec2 start-instances --instance-ids "$instance_id" >/dev/null
    echo "Starting $instance_id..."
    aws ec2 wait instance-running --instance-ids "$instance_id"
    echo "Running. Connect with: workbench ec2 mosh"
    echo "A new instance joins the tailnet by itself on first boot. Give it a few minutes."
    ;;
  down)
    instance_id="$(find_instance_id)"
    aws ec2 stop-instances --instance-ids "$instance_id" >/dev/null
    echo "Stopping $instance_id."
    ;;
  status)
    instance_id="$(find_instance_id)"
    aws ec2 describe-instances --instance-ids "$instance_id" \
      --query 'Reservations[0].Instances[0].{State:State.Name,Type:InstanceType,StartedAt:LaunchTime,PublicIp:PublicIpAddress}' \
      --output table
    ;;
  ssh)
    # Ghostty's own TERM is unknown on the box and its keyboard protocol
    # garbles mosh, so connect with the plain terminal type.
    exec env TERM=xterm-256color ssh "$CONNECT_USER@$(find_connect_host)"
    ;;
  mosh)
    exec env TERM=xterm-256color mosh "$CONNECT_USER@$(find_connect_host)"
    ;;
  ssm)
    exec aws ssm start-session --target "$(find_instance_id)"
    ;;
  update)
    # /opt/agent-workbench is root-owned machine config, not a working copy.
    # Hard reset to origin/main so the box cannot run a stale or local branch.
    exec ssh "$CONNECT_USER@$(find_connect_host)" \
      'sudo git -C /opt/agent-workbench fetch --prune origin main \
        && sudo git -C /opt/agent-workbench reset --hard origin/main \
        && sudo bash /opt/agent-workbench/infra/aws/ec2/setup-workbench.sh'
    ;;
  sync-host)
    sync_host
    ;;
  *)
    usage
    ;;
esac
