#!/usr/bin/env bash
set -euo pipefail

if [ "${1:-}" = "-h" ] || [ "${1:-}" = "--help" ]; then
  echo "Usage: start-herdr [agent] [workspace-dir]"
  echo "Agents: claude codex opencode cursor. Default: cursor in the current directory."
  exit 0
fi

WORKBENCH_AGENT="${1:-cursor}"
WORKSPACE_DIR="$(cd "${2:-$PWD}" && pwd)"

# Key the session to the workspace path (like local_workspace.sh) so a stale
# server from another project is never reused.
workspace_name="$(
  basename "$WORKSPACE_DIR" |
    tr '[:upper:]_' '[:lower:]-' |
    tr -cs '[:alnum:]-' '-' |
    sed 's/^-//; s/-$//'
)"
if [ -z "$workspace_name" ]; then
  workspace_name="workspace"
fi
workspace_path_hash="$(printf '%s' "$WORKSPACE_DIR" | sha256sum | cut -c1-8)"
WORKBENCH_SESSION="${WORKBENCH_SESSION:-$workspace_name-$workspace_path_hash}"
export WORKBENCH_AGENT WORKSPACE_DIR WORKBENCH_SESSION

exec herdr-session
