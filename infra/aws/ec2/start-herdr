#!/usr/bin/env bash
set -euo pipefail

if [ "$#" -gt 2 ]; then
  echo "Usage: start-herdr [claude|codex|opencode|cursor] [WORKSPACE_PATH]" >&2
  exit 1
fi

WORKBENCH_AGENT="${1:-cursor}"
case "$WORKBENCH_AGENT" in
  claude|codex|opencode|cursor) ;;
  *) echo "ERROR: Unknown harness: $WORKBENCH_AGENT" >&2; exit 1 ;;
esac

WORKSPACE_DIR="$(cd "${2:-$PWD}" && pwd -P)"
workspace_name="$(
  basename "$WORKSPACE_DIR" |
    tr '[:upper:]_' '[:lower:]-' |
    tr -cs '[:alnum:]-' '-' |
    sed 's/^-//; s/-$//'
)"
workspace_name="${workspace_name:-workspace}"
workspace_path_hash="$(printf '%s' "$WORKSPACE_DIR" | sha256sum | cut -c1-8)"
WORKBENCH_SESSION="${WORKBENCH_SESSION:-$workspace_name-$workspace_path_hash-$WORKBENCH_AGENT}"

export WORKBENCH_AGENT WORKSPACE_DIR WORKBENCH_SESSION
exec herdr-session
