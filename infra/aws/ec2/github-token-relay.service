[Unit]
Description=GitHub App token relay for the agent workbench
After=network-online.target
Wants=network-online.target

[Service]
User=ubuntu
EnvironmentFile=/etc/agent-workbench/workbench.env
ExecStart=/usr/bin/node /usr/local/lib/agent-workbench/github-token-relay-service.mjs
Restart=on-failure
RestartSec=2

[Install]
WantedBy=multi-user.target
