#!/usr/bin/env bash
# Runs from a systemd timer every 5 minutes. Powering off this box terminates
# it, because the stack sets instanceInitiatedShutdownBehavior to terminate.
set -euo pipefail

# OLLAMA_KEEP_ALIVE holds the model 59 minutes, and a loaded model reads as in
# use. So this only covers the tail: 10 more minutes, about an hour in total.
IDLE_CHECK_LIMIT=2
LLM_PROXY_PORT=11435
COUNT_FILE=/run/agent-workbench/llm-idle-count
# systemd sets no HOME, and a panicking `ollama ps` reads as idle.
export OLLAMA_MODELS=/usr/share/ollama/.ollama/models

mkdir -p /run/agent-workbench

model_is_in_use() {
  # The only signal that survives between prompts, when no socket is open.
  if [ "$(ollama ps 2>/dev/null | wc -l)" -gt 1 ]; then
    return 0
  fi

  # An open session on the proxy, even one waiting on the user's next prompt.
  if [ -n "$(ss -Hn state established "( sport = :$LLM_PROXY_PORT )")" ]; then
    return 0
  fi

  # Someone is on the box by hand. Tailscale carries both ssh and mosh.
  if tailscale status --json 2>/dev/null |
    jq -e '[.Peer[]? | select(.Active)] | length > 0' >/dev/null; then
    return 0
  fi

  if pgrep -f ssm-session-worker >/dev/null 2>&1; then
    return 0
  fi

  return 1
}

if model_is_in_use; then
  echo 0 > "$COUNT_FILE"
  exit 0
fi

idle_count="$(( $(cat "$COUNT_FILE" 2>/dev/null || echo 0) + 1 ))"
echo "$idle_count" > "$COUNT_FILE"

if [ "$idle_count" -ge "$IDLE_CHECK_LIMIT" ]; then
  echo "Nothing used the model for $idle_count checks. Terminating the box."
  systemctl poweroff
fi

