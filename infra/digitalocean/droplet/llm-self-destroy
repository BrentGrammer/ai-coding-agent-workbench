#!/usr/bin/env bash
# Destroys this droplet through the DigitalOcean API. A powered-off GPU
# droplet bills at the full rate, so destroy is the only stop that ends
# billing.
set -uo pipefail

# shellcheck disable=SC1091
. /etc/agent-workbench/digitalocean-secrets.env

droplet_id="$(curl -fsS --max-time 10 http://169.254.169.254/metadata/v1/id)"
if [ -z "$droplet_id" ]; then
  echo "ERROR: Could not read the droplet id from the metadata service." >&2
  exit 1
fi

for _ in 1 2 3; do
  status="$(curl -s -o /dev/null -w '%{http_code}' --max-time 30 \
    -X DELETE \
    -H "Authorization: Bearer $DIGITALOCEAN_LLM_DESTROY_TOKEN" \
    "https://api.digitalocean.com/v2/droplets/$droplet_id")"
  if [ "$status" = "204" ]; then
    exit 0
  fi
  echo "WARN: Destroy returned HTTP $status. Retrying." >&2
  sleep 10
done

# Stay running rather than power off: a running box shows in llm status and
# keeps billing either way, so visibility wins.
echo "ERROR: Could not destroy droplet $droplet_id. It is still billing." >&2
echo "Run: workbench llm down (with WORKBENCH_LLM_PROVIDER=digitalocean)" >&2
exit 1
