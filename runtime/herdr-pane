#!/usr/bin/env bash
set -euo pipefail

: "${WORKBENCH_SESSION:?WORKBENCH_SESSION is required}"

HERDR_LOCAL_DIR="/tmp/agent-workbench/herdr-$WORKBENCH_SESSION"
export XDG_CONFIG_HOME="$HERDR_LOCAL_DIR/config"
export XDG_STATE_HOME="$HERDR_LOCAL_DIR/state"

PANE_ROWS_SCRIPT='
const chunks = [];
process.stdin.on("data", (chunk) => chunks.push(chunk));
process.stdin.on("end", () => {
  let parsed;
  try {
    parsed = JSON.parse(chunks.join(""));
  } catch {
    process.exit(3);
  }

  const isPane = (value) =>
    typeof value.pane_id === "string" || typeof value.terminal_id === "string";

  const findTarget = (pane) =>
    [pane.terminal_id, pane.pane_id, pane.target]
      .find((value) => typeof value === "string" && value);

  const describePane = (pane) =>
    [pane.pane_id, pane.agent, pane.terminal_title_stripped, pane.agent_status,
     pane.cwd]
      .filter((value) => typeof value === "string" && value)
      .join(" · ");

  const panes = [];
  const collectPanes = (value) => {
    if (Array.isArray(value)) {
      value.forEach(collectPanes);
      return;
    }

    if (!value || typeof value !== "object") {
      return;
    }

    if (isPane(value)) {
      panes.push(value);
      return;
    }

    Object.values(value).forEach(collectPanes);
  };

  collectPanes(parsed);

  if (panes.length === 0) {
    process.exit(3);
  }

  panes.forEach((pane) => {
    process.stdout.write(`${findTarget(pane)}\t${describePane(pane) || "pane"}\n`);
  });
});
'

attachPane() {
  if herdr terminal attach "$1"; then
    return 0
  fi

  exec herdr agent attach "$1"
}

if [ "$#" -ge 1 ]; then
  attachPane "$1"
  exit 0
fi

PANE_LIST_JSON="$(herdr pane list 2>/dev/null || true)"
PANE_ROWS="$(printf '%s' "$PANE_LIST_JSON" | node -e "$PANE_ROWS_SCRIPT" 2>/dev/null || true)"

if [ -z "$PANE_ROWS" ]; then
  echo "Could not read the pane list. Herdr printed:"
  herdr pane list 2>/dev/null || herdr terminal list 2>/dev/null || true
  printf '\nOpen one here with:\n  herdr-pane TARGET\n\n'
  exit 1
fi

PANE_TARGETS=()
PANE_LABELS=()

while IFS=$'\t' read -r pane_target pane_description; do
  PANE_TARGETS+=("$pane_target")
  PANE_LABELS+=("$pane_target  —  $pane_description")
done <<< "$PANE_ROWS"

printf '\nPanes in this Herdr session:\n\n'
PS3=$'\nNumber of the pane to open in this window: '

select PANE_CHOICE in "${PANE_LABELS[@]}"; do
  if [ -n "$PANE_CHOICE" ]; then
    attachPane "${PANE_TARGETS[$((REPLY - 1))]}"
    exit 0
  fi

  echo "Pick a number from the list."
done
